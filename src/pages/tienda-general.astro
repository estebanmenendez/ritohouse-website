---

<Layout metadata={metadata}>
  <section class="bg-[#F2E8DF] min-h-screen py-20 text-[#3D2B1F]">
    <div class="max-w-7xl mx-auto px-4">
      
      <div class="text-center mb-16">
        <h1 class="text-5xl font-serif font-bold mb-4 uppercase tracking-tighter">Tienda General</h1>
        <p class="italic text-[#55463C] text-lg mb-8">Elementos individuales para crear tu propio espacio de calma</p>
        
        <div class="flex flex-wrap justify-center gap-4">
          {categorias.map(cat => (
            <a 
              href={`#${cat.id}`} 
              class="px-6 py-2 rounded-full border border-[#B57E5F] font-bold text-[#3D2B1F] hover:bg-[#B57E5F] hover:text-white transition-all text-sm uppercase"
            >
              {cat.nombre}
            </a>
          ))}
        </div>
      </div>

      {categorias.map((cat) => (
        <div id={cat.id} class="mb-20 scroll-mt-24">
          <h2 class="text-3xl font-serif font-bold text-[#B57E5F] border-b border-[#B57E5F]/20 pb-2 mb-10 uppercase tracking-widest text-center md:text-left">
            {cat.nombre}
          </h2>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {accesorios.filter(item => item.categoria === cat.id).map((item) => (
              <div class="bg-white/30 p-4 rounded-2xl border border-[#B57E5F]/10 hover:shadow-lg transition-all flex flex-col items-center text-center group">
                
                {/* CONTENEDOR DE IMAGEN CUADRADA CON ZOOM */}
                <div class="aspect-square w-full bg-[#EAE5DE] rounded-xl mb-4 flex items-center justify-center overflow-hidden shadow-inner relative">
                  {item.imagen ? (
                    <img 
                      src={typeof item.imagen === 'object' ? item.imagen.src : item.imagen} 
                      alt={item.nombre} 
                      data-ampliar={typeof item.imagen === 'object' ? item.imagen.src : item.imagen}
                      class="img-producto w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 cursor-zoom-in"
                    />
                  ) : (
                    <span class="text-xs italic text-[#B57E5F]/40 group-hover:scale-110 transition-transform duration-500 px-2">
                      Foto {item.nombre}
                    </span>
                  )}
                </div>
                
                <p class="text-[10px] uppercase tracking-widest text-[#B57E5F] font-bold mb-1">{item.etiqueta}</p>
                <h3 class="font-bold mb-2 flex-grow text-md leading-tight text-[#3D2B1F]">{item.nombre}</h3>
                <p class="font-serif font-bold mb-4 text-lg text-[#3D2B1F]">${item.precio}</p>
                
                {/* BOTÓN SEGURO CON ATRIBUTOS DATA */}
                <button 
                  data-nombre={item.nombre}
                  data-precio={item.precio}
                  class="btn-agregar-carrito w-full bg-[#3D2B1F] text-[#F2E8DF] py-3 rounded-xl text-sm font-bold hover:bg-[#B57E5F] transition-all active:scale-95 flex items-center justify-center gap-2 shadow-md"
                >
                  <Icon name="tabler:plus" class="w-4 h-4" />
                  Agregar
                </button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<div id="modal-lightbox" class="fixed inset-0 bg-[#3D2B1F]/90 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
  <button id="cerrar-lightbox" class="absolute top-6 right-6 text-[#F2E8DF] hover:text-[#B57E5F] transition-colors bg-white/10 p-2 rounded-full">
    <Icon name="tabler:x" class="w-8 h-8" />
  </button>
  <div class="max-w-3xl max-h-[85vh] overflow-hidden rounded-2xl shadow-2xl relative bg-[#F2E8DF] p-2">
    <img id="imagen-lightbox" src="" alt="Producto ampliado" class="max-w-full max-h-[80vh] object-contain rounded-xl" />
  </div>
</div>

<script>
  const inicializarTiendaGeneral = () => {
    // ---- EVENTO DE BOTONES DE CARRITO ----
    const botones = document.querySelectorAll('.btn-agregar-carrito');
    botones.forEach(boton => {
      boton.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const nombre = target.getAttribute('data-nombre');
        const precio = target.getAttribute('data-precio');
        
        if (typeof (window as any).agregarAlCarrito === 'function') {
          (window as any).agregarAlCarrito(nombre, precio);
        }
      });
    });

    // ---- EFECTO LIGHTBOX (ZOOM FOTOS) ----
    const modal = document.getElementById('modal-lightbox');
    const imgModal = document.getElementById('imagen-lightbox') as HTMLImageElement;
    const btnCerrar = document.getElementById('cerrar-lightbox');
    const imagenesClickables = document.querySelectorAll('.img-producto');

    imagenesClickables.forEach(img => {
      img.addEventListener('click', (e) => {
        const target = e.target as HTMLImageElement;
        const rutaImagen = target.getAttribute('data-ampliar');
        
        if (modal && imgModal && rutaImagen) {
          imgModal.src = rutaImagen;
          imgModal.alt = target.alt;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }
      });
    });

    const cerrarModal = () => {
      if (modal) {
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
        }, 300);
      }
    };

    if (btnCerrar) btnCerrar.addEventListener('click', cerrarModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) cerrarModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarModal();
    });
  };

  // Se ejecuta de manera segura al cargar y cambiar de página bajo el Router de Astro
  document.addEventListener('astro:page-load', inicializarTiendaGeneral);
</script>
