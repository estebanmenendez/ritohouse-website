---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

// 1. IMPORTACIÓN DE FOTOS (Solo las que ya existen físicamente en tu repositorio)
import fotoInicio from '~/assets/images/box-inicio.png';
import fotoPurificacion from '~/assets/images/box-purificacion.png';
import fotoCalma from '~/assets/images/box-calma.png';
import fotoAbundancia from '~/assets/images/box-abundancia.png'; 

const metadata = {
  title: 'Tienda de Rituales — RitoHouse',
};

const productos = [
  // 1. ESENCIALES (Completado con 4 boxes y sus fotos listas)
  {
    id: 'e1',
    categoria: 'esenciales',
    nombre: 'Box Inicio Sagrado',
    descripcion: 'Lo fundamental para tu primer ritual de limpieza energética.',
    precio: '750',
    imagen: fotoInicio, 
  },
  {
    id: 'e2',
    categoria: 'esenciales',
    nombre: 'Box Purificación',
    descripcion: 'Ideal para limpiar nuevos espacios y renovar el aire del hogar.',
    precio: '850',
    imagen: fotoPurificacion, 
  },
  {
    id: 'e3',
    categoria: 'esenciales',
    nombre: 'Box Calma Interior',
    descripcion: 'Enfocado en la relajación diaria y el descenso del estrés.',
    precio: '750',
    imagen: fotoCalma, 
  },
  {
    id: 'e4',
    categoria: 'esenciales',
    nombre: 'Box Abundancia Flor',
    descripcion: 'Atrae la prosperidad con botánica seca y cristales seleccionados.',
    precio: '750',
    imagen: fotoAbundancia, 
  },

  // 2. EXPANSIÓN (Completado con 4 boxes - El nuevo queda en espera de su foto)
  {
    id: 'ex1',
    categoria: 'expansion',
    nombre: 'Box Expansión Áurea',
    descripcion: 'Conexión profunda con elementos de la naturaleza y decretos.',
    precio: 'Proximamente',
    imagen: '',
  },
  {
    id: 'ex2',
    categoria: 'expansion', 
    nombre: 'Box Altar Místico',
    descripcion: 'Eleva la vibración de tu rincón sagrado con piezas exclusivas.',
    precio: 'Proximamente',
    imagen: '', 
  },
  {
    id: 'ex3',
    categoria: 'expansion',
    nombre: 'Box Protection Hogar',
    descripcion: 'Crea un escudo energético en las entradas de tu casa.',
    precio: 'Proximamente',
    imagen: '',
  },
  {
    id: 'ex4',
    categoria: 'expansion',
    nombre: 'Box Armonía Familiar',
    descripcion: 'Ritual diseñado para equilibrar la convivencia en espacios comunes.',
    precio: 'Proximamente',
    imagen: '',
  },

  // 3. TRASCENDENCIA (Completado con 4 boxes)
  {
    id: 't1',
    categoria: 'trascendencia',
    nombre: 'Box Trascendencia Total',
    descripcion: 'La experiencia de alquimia definitiva con piezas de diseño.',
    precio: 'Proximamente',
    imagen: '',
  },
  {
    id: 't2',
    categoria: 'trascendencia',
    nombre: 'Box Alquimia Ancestral',
    descripcion: 'Kit profesional con elementos de sahumado antiguo y resinas.',
    precio: 'Proximamente',
    imagen: '',
  },
  {
    id: 't3',
    categoria: 'trascendencia',
    nombre: 'Box Ritual de Vida',
    descripcion: 'Un viaje completo por los 4 elementos para momentos de cambio.',
    precio: 'Proximamente',
    imagen: '',
  },
  {
    id: 't4',
    categoria: 'trascendencia',
    nombre: 'Box Maestro de Luz',
    descripcion: 'Set premium con nuestras piezas de cemento más exclusivas.',
    precio: 'Proximamente',
    imagen: '',
  }
];
---

<Layout metadata={metadata}>
  <section class="bg-[#F2E8DF] min-h-screen py-20 text-[#3D2B1F]">
    <div class="max-w-7xl mx-auto px-4">
      
      <div class="text-center mb-16">
        <h1 class="text-5xl font-serif font-bold mb-4 uppercase tracking-tighter">Catálogo de Rituales</h1>
        <p class="italic text-[#55463C] text-lg">Selecciona tu intención y arma tu pedido personalizado</p>
        
        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a href="#esenciales" class="px-6 py-2 rounded-full border border-[#B57E5F] font-bold hover:bg-[#B57E5F] hover:text-white transition-all text-sm">ESENCIALES</a>
          <a href="#expansion" class="px-6 py-2 rounded-full border border-[#B57E5F] font-bold hover:bg-[#B57E5F] hover:text-white transition-all text-sm">EXPANSIÓN</a>
          <a href="#trascendencia" class="px-6 py-2 rounded-full border border-[#B57E5F] font-bold hover:bg-[#B57E5F] hover:text-white transition-all text-sm">TRASCENDENCIA</a>
        </div>
      </div>

      {/* RENDERIZADO DE CATEGORÍAS */}
      {['esenciales', 'expansion', 'trascendencia'].map((cat, index) => (
        <div id={cat} class="mb-24 scroll-mt-24">
          <h2 class="text-3xl font-serif font-bold text-[#B57E5F] border-b border-[#B57E5F]/20 pb-2 mb-10 uppercase tracking-widest text-center md:text-left">
            {cat === 'esenciales' && "I. Rituales de Iniciación y Purificación"}
            {cat === 'expansion' && "II. Rituales de Expansión y Conexión"}
            {cat === 'trascendencia' && "III. Rituales de Trascendencia Total"}
          </h2>
          
          <div class="grid md:grid-cols-4 gap-6">
            {productos.filter(p => p.categoria === cat).map(p => (
              <div class="bg-white/30 rounded-2xl border border-[#B57E5F]/10 p-5 flex flex-col items-center text-center group hover:shadow-xl transition-all">
                
                {/* CONTENEDOR DE IMAGEN CUADRADA CON ZOOM */}
                <div class="aspect-square w-full bg-[#EAE5DE] rounded-xl mb-4 flex items-center justify-center overflow-hidden shadow-inner relative">
                  {p.imagen ? (
                    <img 
                      src={typeof p.imagen === 'object' ? p.imagen.src : p.imagen} 
                      alt={p.nombre} 
                      data-ampliar={typeof p.imagen === 'object' ? p.imagen.src : p.imagen}
                      class="img-producto w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 cursor-zoom-in"
                    />
                  ) : (
                    <span class="text-xs italic text-[#B57E5F]/40 group-hover:scale-110 transition-transform duration-500 px-2">
                      Foto {p.nombre}
                    </span>
                  )}
                </div>

                <h3 class="text-lg font-bold mb-2 leading-tight text-[#3D2B1F]">{p.nombre}</h3>
                <p class="text-xs text-[#55463C] mb-4 flex-grow italic">{p.descripcion}</p>
                <div class="mb-5">
                  <span class="text-xl font-serif font-bold text-[#3D2B1F]">${p.precio}</span>
                </div>
                
                {/* BOTÓN SEGURO SIN ONCLICK INTERNO */}
                <button 
                  data-nombre={p.nombre}
                  data-precio={p.precio}
                  class="btn-agregar-carrito w-full bg-[#3D2B1F] text-[#F2E8DF] py-3 rounded-xl font-bold hover:bg-[#B57E5F] transition-all flex items-center justify-center gap-2 active:scale-95 shadow-md"
                >
                  <Icon name="tabler:shopping-bag" class="w-5 h-5" /> Agregar
                </button>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<div id="modal-lightbox" class="fixed inset-0 bg-[#3D2B1F]/90 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
  <button id="cerrar-lightbox" class="absolute top-6 right-6 text-[#F2E8DF] hover:text-[#B57E5F] transition-colors bg-white/10 p-2 rounded-full">
    <Icon name="tabler:x" class="w-8 h-8" />
  </button>
  <div class="max-w-3xl max-h-[85vh] overflow-hidden rounded-2xl shadow-2xl relative bg-[#F2E8DF] p-2">
    <img id="imagen-lightbox" src="" alt="Producto ampliado" class="max-w-full max-h-[80vh] object-contain rounded-xl" />
  </div>
</div>

<script>
  const inicializarTiendaRituales = () => {
    // ---- EVENTO DE BOTONES DE CARRITO ----
    const botones = document.querySelectorAll('.btn-agregar-carrito');
    botones.forEach(boton => {
      boton.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const nombre = target.getAttribute('data-nombre');
        const precio = target.getAttribute('data-precio');
        
        if (typeof (window as any).agregarAlCarrito === 'function') {
          (window as any).agregarAlCarrito(nombre, precio);
        }
      });
    });

    // ---- EFECTO LIGHTBOX (ZOOM FOTOS) ----
    const modal = document.getElementById('modal-lightbox');
    const imgModal = document.getElementById('imagen-lightbox') as HTMLImageElement;
    const btnCerrar = document.getElementById('cerrar-lightbox');
    const imagenesClickables = document.querySelectorAll('.img-producto');

    imagenesClickables.forEach(img => {
      img.addEventListener('click', (e) => {
        const target = e.target as HTMLImageElement;
        const rutaImagen = target.getAttribute('data-ampliar');
        
        if (modal && imgModal && rutaImagen) {
          imgModal.src = rutaImagen;
          imgModal.alt = target.alt;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }
      });
    });

    const cerrarModal = () => {
      if (modal) {
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
        }, 300);
      }
    };

    if (btnCerrar) btnCerrar.addEventListener('click', cerrarModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) cerrarModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') cerrarModal();
    });
  };

  // Escucha segura de ciclo de vida compatible con ClientRouter de Astro
  document.addEventListener('astro:page-load', inicializarTiendaRituales);
</script>
